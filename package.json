{
  "name": "hublink",
  "productName": "Hublink",
  "version": "0.4.2",
  "description": "Client desktop leger pour regrouper les webapps de plusieurs comptes clients, avec sessions isolees et extensions Chrome.",
  "main": "src/main/index.js",
  "author": "Luth",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-port 5273 && electron . --dev\"",
    "dev:renderer": "vite",
    "dev:electron": "electron . --dev",
    "build": "vite build",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist": "npm run build && electron-builder --mac --win"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^1.33.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-port": "^1.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Luth-infinity/hublink.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
